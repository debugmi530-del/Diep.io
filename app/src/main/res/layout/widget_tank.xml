<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center"
    android:background="#CC0D0D1F">

    <TextView
        android:id="@+id/widget_tank_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡"
        android:textSize="28sp"
        android:gravity="center"/>

    <TextView
        android:id="@+id/widget_tank_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нет танка"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/widget_tank_tier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tier —"
        android:textColor="#8800CCFF"
        android:textSize="10sp"
        android:gravity="center"
        android:layout_marginTop="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_tank_dps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DPS\n—"
            android:textColor="#FFFF8040"
            android:textSize="9sp"
            android:gravity="center"
            android:lines="2"/>

        <TextView
            android:id="@+id/widget_tank_hp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HP\n—"
            android:textColor="#FF80FF60"
            android:textSize="9sp"
            android:gravity="center"
            android:lines="2"/>

        <TextView
            android:id="@+id/widget_tank_barrels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Стволов\n—"
            android:textColor="#FFCC80FF"
            android:textSize="9sp"
            android:gravity="center"
            android:lines="2"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_open_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нажми для открытия"
        android:textColor="#44FFFFFF"
        android:textSize="8sp"
        android:gravity="center"
        android:layout_marginTop="4dp"/>
</LinearLayout>
